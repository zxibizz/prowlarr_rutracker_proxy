# Copy to .env and fill in. docker compose reads this file automatically.

# --- Prowlarr ----------------------------------------------------------------
# Only scripts/ reads these, and only from the environment - compose loads this
# file for the containers, but your shell does not:
#     set -a; source .env; set +a
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# --- RuTracker account -------------------------------------------------------
# The proxy owns the tracker session, so these are the credentials that get used.
# The ones configured on the Prowlarr indexer are ignored.
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=

# --- network -----------------------------------------------------------------
# All upstream tracker traffic, and FlareSolverr's browser, go through this.
# Use socks5h:// so DNS is resolved at the far end rather than locally.
# Leave empty to go direct (only useful when developing from an unblocked network).
SOCKS5_URL=socks5h://host.docker.internal:1080

# First entry is canonical: whatever mirror actually answers, Prowlarr only ever
# sees hostnames rewritten to this one.
RUTRACKER_MIRRORS=https://rutracker.org,https://rutracker.net

# --- tuning ------------------------------------------------------------------
FLARESOLVERR_TIMEOUT_MS=60000
FLARESOLVERR_LOG_LEVEL=info
# Consecutive failures before the next mirror takes over.
MIRROR_FAIL_THRESHOLD=2
# How long a demoted mirror stays demoted before it is probed again.
MIRROR_RECHECK_SECONDS=900
# Minimum gap between upstream requests, in seconds.
REQUEST_DELAY=0.25
LOG_LEVEL=INFO

# --- containers --------------------------------------------------------------
PUID=1000
PGID=1000
TZ=UTC
